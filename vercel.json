{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(fonts|vendor|map)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 5 * * *"
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://andrehennen.com/adc-lounge/mitmachen/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "https://andrehennen.com/adc-lounge/mitmachen/",
      "permanent": false
    },
    {
      "source": "/jury",
      "destination": "https://andrehennen.com/adc-lounge/jury/",
      "permanent": false
    },
    {
      "source": "/jury.html",
      "destination": "https://andrehennen.com/adc-lounge/jury/",
      "permanent": false
    },
    {
      "source": "/datenschutz",
      "destination": "https://andrehennen.com/adc-lounge/mitmachen/datenschutz.html",
      "permanent": false
    },
    {
      "source": "/impressum",
      "destination": "https://www.adc.de/impressum/",
      "permanent": false
    }
  ]
}
